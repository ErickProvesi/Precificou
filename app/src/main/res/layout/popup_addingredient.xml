<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="370dp"
    android:layout_height="480dp"
    android:background="@drawable/popup_background"
    android:padding="5dp"
    android:layout_gravity="center"
    android:id="@+id/popaddingredient"
    >

    <SearchView
        android:id="@+id/schMyIngredients2"
        android:layout_width="350dp"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="4dp"
        android:queryHint="Pesquisar Ingrediente"
        android:theme="@style/SchText"
        android:iconifiedByDefault="false"
        android:background="@drawable/custom_search"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RywViewIngredient"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/view_addingredient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="120dp"
        android:layout_height="36dp"
        android:layout_marginTop="13dp"
        android:layout_gravity="center"
        android:paddingTop="5dp"
        android:background="@drawable/custom_button"
        android:text="Salvar"
        android:fontFamily="@font/poppinsextrabold"
        android:textSize="13sp"
        android:textColor="@color/black"
        android:textAlignment="center"
        />

</LinearLayout>

