<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="323dp"
    android:layout_height="250dp"
    android:background="@drawable/popup_background"
    android:padding="5dp"
    android:layout_gravity="center"
    >

    <TextView
        android:id="@+id/txtQuantityIngredient"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"
        android:text="Quantidade Ingrediente"
        android:fontFamily="@font/poppinsextrabold"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <TextView
        android:id="@+id/txtIngredient"
        android:layout_width="280dp"
        android:layout_height="50dp"
        android:layout_marginTop="13dp"
        android:paddingTop="12dp"
        android:layout_gravity="center"
        android:text="Nome Ingrediente"
        android:fontFamily="@font/poppinsextrabold"
        android:textSize="17sp"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:background="@drawable/custom_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal">

    <EditText
        android:id="@+id/edtQuantity"
        android:layout_width="145dp"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:paddingTop="2dp"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        android:layout_gravity="center"
        android:inputType="number"
        android:hint="Quantidade"
        android:fontFamily="@font/poppinssemibold"
        android:textSize="15dp"
        android:textColor="@color/black"
        android:textColorHint="@color/hintColor"
        android:background="@drawable/custom_edit_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.150"
        />

        <Spinner
            android:id="@+id/SpinnerTypeQuantity"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:layout_gravity="center"
            android:background="@drawable/spinner_und"
            android:entries="@array/SpinnerUndProduto"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:theme="@style/spinnerUnd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.867"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.594" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveQtdIng"
        android:layout_width="130dp"
        android:layout_height="40dp"
        android:paddingTop="5dp"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:text="Salvar"
        android:fontFamily="@font/poppinsbold"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:background="@drawable/custom_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.886"
        />

</LinearLayout>