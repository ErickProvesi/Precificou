<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="411dp"
    android:layout_height="823dp"
    android:fillViewport="true"
    android:outlineSpotShadowColor="#FFFFFF"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/TelaProduto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#222222"
        tools:context=".Principal">

        <Button
            android:id="@+id/btnAddProduct"
            android:layout_width="76dp"
            android:layout_height="35dp"
            android:layout_marginTop="95dp"
            android:background="@drawable/custom_button"
            android:drawableTop="@drawable/ic_iconeadicionar"
            android:gravity="center"
            android:paddingTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/schMyProducts"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppinsextrabold"
            android:letterSpacing="0.2"
            android:text="Produtos"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <SearchView
            android:id="@+id/schMyProducts"
            android:layout_width="300dp"
            android:layout_height="33dp"
            android:layout_marginTop="96dp"
            android:background="@drawable/custom_search"
            android:queryHint="Pesquisar Produtos"
            android:theme="@style/SchText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.036"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:iconifiedByDefault="false"
            />

        <View
            android:id="@+id/viwViewProducts"
            android:layout_width="fill_parent"
            android:layout_height="665dp"
            android:layout_marginTop="156dp"
            android:background="@drawable/view_products"
            android:outlineAmbientShadowColor="#FFFFFF"
            android:outlineSpotShadowColor="#FFFFFF"
            app:circularflow_defaultRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/MeusProdutos"
            android:layout_width="match_parent"
            android:layout_height="640dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.989" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>